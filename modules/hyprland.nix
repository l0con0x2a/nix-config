{ config, pkgs, lib, ... }:

let
  lua = lib.generators.mkLuaInline;
in
{
  wayland.windowManager.hyprland = {
    enable = true;
    package = null;
    portalPackage = null;

    configType = "lua";

    settings = {
      terminal._var = "kitty";
      fileManager._var = "dolphin";
      menu._var = "hyprlauncher";
      mainMod._var = "SUPER";

      monitor = {
        output = "";
        mode = "preferred";
        position = "auto";
        scale = "auto";
      };

      env = [
        {
          _args = [ "XCURSOR_SIZE" "24" ];
        }
        {
          _args = [ "HYPRCURSOR_SIZE" "24" ];
        }
      ];

      config = {
        autogenerated = false;

        general = {
          gaps_in = 5;
          gaps_out = 20;
          border_size = 2;

          col = {
            active_border = {
              colors = [ "rgba(33ccffee)" "rgba(00ff99ee)" ];
              angle = 45;
            };
            inactive_border = "rgba(595959aa)";
          };

          resize_on_border = false;
          allow_tearing = false;
          layout = "dwindle";
        };

        decoration = {
          rounding = 10;
          rounding_power = 2;

          active_opacity = 1.0;
          inactive_opacity = 1.0;

          shadow = {
            enabled = true;
            range = 4;
            render_power = 3;
            color = lua "0xee1a1a1a";
          };

          blur = {
            enabled = true;
            size = 3;
            passes = 1;
            vibrancy = 0.1696;
          };
        };

        animations = {
          enabled = true;
        };

        dwindle = {
          preserve_split = true;
        };

        master = {
          new_status = "master";
        };

        scrolling = {
          fullscreen_on_one_column = true;
        };

        misc = {
          force_default_wallpaper = -1;
          disable_hyprland_logo = false;
        };

        input = {
          kb_layout = "us";
          kb_variant = "";
          kb_model = "";
          kb_options = "ctrl:nocaps";
          kb_rules = "";

          follow_mouse = 1;
          sensitivity = 0;

          touchpad = {
            natural_scroll = false;
          };
        };
      };

      gesture = {
        fingers = 3;
        direction = "horizontal";
        action = "workspace";
      };

      # default config の example device。不要なら消してOK。
      device = {
        name = "epic-mouse-v1";
        sensitivity = -0.5;
      };

      bind =
        [
          # SUPER + Q -> terminal
          {
            _args = [
              (lua ''mainMod .. " + Q"'')
              (lua "hl.dsp.exec_cmd(terminal)")
            ];
          }

          # SUPER + C -> close active window
          {
            _args = [
              (lua ''mainMod .. " + C"'')
              (lua "hl.dsp.window.close()")
            ];
          }

          # SUPER + M -> exit / hyprshutdown
          {
            _args = [
              (lua ''mainMod .. " + M"'')
              (lua ''hl.dsp.exec_cmd("command -v hyprshutdown >/dev/null 2>&1 && hyprshutdown || hyprctl dispatch exit")'')
            ];
          }

          # SUPER + E -> file manager
          {
            _args = [
              (lua ''mainMod .. " + E"'')
              (lua "hl.dsp.exec_cmd(fileManager)")
            ];
          }

          # SUPER + V -> toggle floating
          {
            _args = [
              (lua ''mainMod .. " + V"'')
              (lua ''hl.dsp.window.float({ action = "toggle" })'')
            ];
          }

          # SUPER + R -> launcher
          {
            _args = [
              (lua ''mainMod .. " + R"'')
              (lua "hl.dsp.exec_cmd(menu)")
            ];
          }

          # SUPER + P -> pseudo
          {
            _args = [
              (lua ''mainMod .. " + P"'')
              (lua "hl.dsp.window.pseudo()")
            ];
          }

          # SUPER + J -> togglesplit
          {
            _args = [
              (lua ''mainMod .. " + J"'')
              (lua ''hl.dsp.layout("togglesplit")'')
            ];
          }

          # Move focus with SUPER + arrow keys
          {
            _args = [
              (lua ''mainMod .. " + left"'')
              (lua ''hl.dsp.focus({ direction = "left" })'')
            ];
          }
          {
            _args = [
              (lua ''mainMod .. " + right"'')
              (lua ''hl.dsp.focus({ direction = "right" })'')
            ];
          }
          {
            _args = [
              (lua ''mainMod .. " + up"'')
              (lua ''hl.dsp.focus({ direction = "up" })'')
            ];
          }
          {
            _args = [
              (lua ''mainMod .. " + down"'')
              (lua ''hl.dsp.focus({ direction = "down" })'')
            ];
          }

          # Special workspace
          {
            _args = [
              (lua ''mainMod .. " + S"'')
              (lua ''hl.dsp.workspace.toggle_special("magic")'')
            ];
          }
          {
            _args = [
              (lua ''mainMod .. " + SHIFT + S"'')
              (lua ''hl.dsp.window.move({ workspace = "special:magic" })'')
            ];
          }

          # Scroll workspaces
          {
            _args = [
              (lua ''mainMod .. " + mouse_down"'')
              (lua ''hl.dsp.focus({ workspace = "e+1" })'')
            ];
          }
          {
            _args = [
              (lua ''mainMod .. " + mouse_up"'')
              (lua ''hl.dsp.focus({ workspace = "e-1" })'')
            ];
          }

          # Move/resize windows with mouse
          {
            _args = [
              (lua ''mainMod .. " + mouse:272"'')
              (lua "hl.dsp.window.drag()")
              { mouse = true; }
            ];
          }
          {
            _args = [
              (lua ''mainMod .. " + mouse:273"'')
              (lua "hl.dsp.window.resize()")
              { mouse = true; }
            ];
          }

          # Volume / brightness
          {
            _args = [
              "XF86AudioRaiseVolume"
              (lua ''hl.dsp.exec_cmd("wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+")'')
              { locked = true; repeating = true; }
            ];
          }
          {
            _args = [
              "XF86AudioLowerVolume"
              (lua ''hl.dsp.exec_cmd("wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-")'')
              { locked = true; repeating = true; }
            ];
          }
          {
            _args = [
              "XF86AudioMute"
              (lua ''hl.dsp.exec_cmd("wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle")'')
              { locked = true; repeating = true; }
            ];
          }
          {
            _args = [
              "XF86AudioMicMute"
              (lua ''hl.dsp.exec_cmd("wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle")'')
              { locked = true; repeating = true; }
            ];
          }
          {
            _args = [
              "XF86MonBrightnessUp"
              (lua ''hl.dsp.exec_cmd("brightnessctl -e4 -n2 set 5%+")'')
              { locked = true; repeating = true; }
            ];
          }
          {
            _args = [
              "XF86MonBrightnessDown"
              (lua ''hl.dsp.exec_cmd("brightnessctl -e4 -n2 set 5%-")'')
              { locked = true; repeating = true; }
            ];
          }

          # playerctl
          {
            _args = [
              "XF86AudioNext"
              (lua ''hl.dsp.exec_cmd("playerctl next")'')
              { locked = true; }
            ];
          }
          {
            _args = [
              "XF86AudioPause"
              (lua ''hl.dsp.exec_cmd("playerctl play-pause")'')
              { locked = true; }
            ];
          }
          {
            _args = [
              "XF86AudioPlay"
              (lua ''hl.dsp.exec_cmd("playerctl play-pause")'')
              { locked = true; }
            ];
          }
          {
            _args = [
              "XF86AudioPrev"
              (lua ''hl.dsp.exec_cmd("playerctl previous")'')
              { locked = true; }
            ];
          }
        ]
        ++ builtins.concatLists (
          builtins.genList
            (i:
              let
                ws = i + 1;
                key = if ws == 10 then "0" else toString ws;
              in
              [
                {
                  _args = [
                    (lua ''mainMod .. " + ${key}"'')
                    (lua ''hl.dsp.focus({ workspace = ${toString ws} })'')
                  ];
                }
                {
                  _args = [
                    (lua ''mainMod .. " + SHIFT + ${key}"'')
                    (lua ''hl.dsp.window.move({ workspace = ${toString ws} })'')
                  ];
                }
              ]
            )
            10
        );

      window_rule = [
        {
          name = "suppress-maximize-events";
          match = {
            class = ".*";
          };
          suppress_event = "maximize";
        }

        {
          name = "fix-xwayland-drags";
          match = {
            class = "^$";
            title = "^$";
            xwayland = true;
            float = true;
            fullscreen = false;
            pin = false;
          };
          no_focus = true;
        }

        {
          name = "move-hyprland-run";
          match = {
            class = "hyprland-run";
          };
          move = "20 monitor_h-120";
          float = true;
        }
      ];
    };
  };
}
